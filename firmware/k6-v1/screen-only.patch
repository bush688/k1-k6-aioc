+void UART_ViewerSendStripe(void)
+{
+    if (viewerStripe >= 128 || gCurrentFunction == FUNCTION_TRANSMIT)
+        return;
+
+    // Each response is one horizontal 64-pixel stripe in the K1 viewer format.
+    uint8_t packet[15] = {0xAA, 0x55, 0x02, 0, 9, viewerStripe};
+    unsigned page = viewerStripe / 16;
+    unsigned bit = (viewerStripe % 16) / 2;
+    unsigned column = (viewerStripe % 2) * 64;
+    const uint8_t *line = page ? gFrameBuffer[page - 1] : gStatusLine;
+    for (unsigned x = 0; x < 64; ++x)
+        packet[6 + x / 8] |= ((line[column + x] >> bit) & 1u) << (x % 8);
+
+    packet[14] = 0x0A;
+    ++viewerStripe;
+    UART_Send(packet, sizeof(packet));
+}
