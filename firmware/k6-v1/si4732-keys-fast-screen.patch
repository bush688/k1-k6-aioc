+
+void UART_ViewerSendStripe(void)
+{
+    if (viewerStripe >= 128 || gCurrentFunction == FUNCTION_TRANSMIT)
+        return;
+
+    // Skip unchanged stripes, but periodically resend a full screen for reconnects.
+    for (unsigned checked = 0; checked < 16 && viewerStripe < 128; ++checked) {
+        const uint8_t stripe = viewerStripe++;
+        uint8_t packet[15] = {0xAA, 0x55, 0x02, 0, 9, stripe};
+        const unsigned page = stripe / 16;
+        const unsigned bit = (stripe % 16) / 2;
+        const unsigned column = (stripe % 2) * 64;
+        const uint8_t *line = page ? gFrameBuffer[page - 1] : gStatusLine;
+        for (unsigned x = 0; x < 64; ++x)
+            packet[6 + x / 8] |= ((line[column + x] >> bit) & 1u) << (x % 8);
+
+        if (!viewerFullRefresh && memcmp(packet + 6, viewerLastStripe[stripe], 8) == 0)
+            continue;
+        memcpy(viewerLastStripe[stripe], packet + 6, 8);
+        packet[14] = 0x0A;
+        UART_Send(packet, sizeof(packet));
+        return;
+    }
+}
